  {
    "id": "crud_page_entity",
    "kind": "required_when",
    "level": "error",
    "path": "/pages/$1/entity",
    "if": {
      "path": "/pages/*/type",
      "equals": "crud"
    },
    "message": "A crud page needs the entity it lists."
  },
  {
    "id": "detail_page_view",
    "kind": "required_when",
    "level": "error",
    "path": "/pages/$1/detail_view",
    "if": {
      "path": "/pages/*/type",
      "equals": "detail"
    },
    "message": "A detail page needs the detail_view it shows."
  },
  {
    "id": "link_field_target",
    "kind": "required_when",
    "level": "error",
    "path": "/modules/$1/entities/$2/fields/$3/$4/to",
    "if": {
      "path": "/modules/*/entities/*/fields/*/*/type",
      "equals": "link"
    },
    "message": "A link field needs `to`: the entity it points at."
  },
  {
    "id": "multi_link_field_target",
    "kind": "required_when",
    "level": "error",
    "path": "/modules/$1/entities/$2/fields/$3/$4/to",
    "if": {
      "path": "/modules/*/entities/*/fields/*/*/type",
      "equals": "multi_link"
    },
    "message": "A multi_link field needs `to`: the entity it points at."
  },
  {
    "id": "choice_field_choices",
    "kind": "required_when",
    "level": "error",
    "path": "/modules/$1/entities/$2/fields/$3/$4/choices",
    "if": {
      "path": "/modules/*/entities/*/fields/*/*/type",
      "equals": "choice"
    },
    "message": "A choice field needs choices (a choice set code or inline options)."
  },
  {
    "id": "multi_choice_field_choices",
    "kind": "required_when",
    "level": "error",
    "path": "/modules/$1/entities/$2/fields/$3/$4/choices",
    "if": {
      "path": "/modules/*/entities/*/fields/*/*/type",
      "equals": "multi_choice"
    },
    "message": "A multi_choice field needs choices."
  },
  {
    "id": "custom_page_preview",
    "kind": "required_when",
    "level": "warning",
    "path": "/pages/$1/preview",
    "if": {
      "path": "/pages/*/type",
      "equals": "custom"
    },
    "message": "This custom page has no preview sketch, so the preview shows a placeholder. Add `preview` (SCHEMA.md: Custom screens with a preview)."
  },
  {
    "id": "custom_tab_preview",
    "kind": "required_when",
    "level": "warning",
    "path": "/detail_views/$1/tabs/$2/preview",
    "if": {
      "path": "/detail_views/*/tabs/*/type",
      "equals": "custom"
    },
    "message": "This custom tab has no preview sketch, so the preview shows a placeholder. Add `preview` (SCHEMA.md: Custom screens with a preview)."
  },
  {
    "id": "custom_panel_preview",
    "kind": "required_when",
    "level": "warning",
    "path": "/detail_views/$1/sidebar/$2/preview",
    "if": {
      "path": "/detail_views/*/sidebar/*/type",
      "equals": "custom"
    },
    "message": "This custom sidebar section has no preview sketch, so the preview shows a placeholder. Add `preview` (SCHEMA.md: Custom screens with a preview)."
  }
]
