  {
    "id": "role_name_unique",
    "kind": "unique",
    "level": "error",
    "path": "/roles/*",
    "key": "name",
    "message": "Two roles are named \"{value}\"."
  },
  {
    "id": "page_code_unique",
    "kind": "unique",
